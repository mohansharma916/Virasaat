DB_USERNAME=""
DB_PASSWORD=""
DB_HOST=""
DB_PORT=3000
NODE_ENV="development"
DB_SYNCHRONIZE="false"
# Set specific trusted proxy IPs/CIDRs or the verified proxy hop count (e.g. 1).
# Leave false for direct connections. Never use true or all-address ranges.
TRUST_PROXY="false"
DB_DATABASE=""
PORT=
JWT_SECRET=""
JWT_EXPIRES_IN=""
GOOGLE_CLIENT_ID=""
CLIENT_SECRET=""
ENCRYPTION_MASTER_KEY="base64-encoded-32-byte-master-key"
ENCRYPTION_MASTER_KEY_VERSION="v1"
# Retain historical keys when rotating: JSON object mapping versions to base64 keys.
ENCRYPTION_MASTER_KEYS="{}"
# Deep links supported by the mobile app. Override only with implemented routes.
APP_HOME_URL="virasat://home"
APP_RECOVERY_URL="virasat://forgot-password"
APP_SECURITY_URL="virasat://security"
# Required for JWT-authenticated development email diagnostics; disabled in production.
EMAIL_DIAGNOSTICS_TOKEN=""
# Development test email can only be sent to this configured destination.
EMAIL_DIAGNOSTICS_TO=""

# AWS S3 Vault Secure Storage
AWS_REGION="ap-south-1"
# Leave these empty on servers using an IAM role (the SDK provider chain).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
AWS_S3_BUCKET_NAME="virasaat-vault-storage"
AWS_S3_ENDPOINT="" # Optional
AWS_S3_FORCE_PATH_STYLE="false" # Optional
AWS_S3_KMS_KEY_ID="" # Optional

# Nodemailer / SMTP Email Delivery Configuration
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_SERVICE="gmail"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="\"Virasat\" <your-email@gmail.com>"
# Optional custom SMTP host & port (only needed if NOT using standard service like 'gmail')
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
